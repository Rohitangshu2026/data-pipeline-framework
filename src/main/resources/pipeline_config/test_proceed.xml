<job id="test_proceed">
    <stage id="extract">
        <on_error handling_strategy="proceed" />
        <task>
            <input type="csv">
                <param name="src" value="non_existent.csv"/>
            </input>
            <action type="ReadCSV">
                <method name="read"/>
            </action>
            <output type="csv">
                <param name="src" value="raw_data.csv"/>
            </output>
        </task>
    </stage>

    <stage id="transform_stage" pre_req="extract">
        <task>
            <input type="csv">
                <param name="src" value="src/main/resources/input/employees.csv"/>
            </input>
            <action type="transform">
                <method name="limit">
                     <param name="count" value="5"/>
                </method>
            </action>
            <output type="csv">
                <param name="src" value="src/main/resources/output/clean_data.csv"/>
            </output>
        </task>
    </stage>
</job>
