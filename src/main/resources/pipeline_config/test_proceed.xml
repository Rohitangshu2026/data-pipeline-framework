<job id="test_proceed">
    <stage id="extract">
        <on_error handling_strategy="proceed" />
        <task>
            <input>
                <csv src="non_existent.csv"/>
            </input>
            <action type="ReadCSV">
                <method name="read"/>
            </action>
            <output>
                <csv src="raw_data.csv"/>
            </output>
        </task>
    </stage>

    <stage id="transform_stage" pre_req="extract">
        <task>
            <input>
                <csv src="src/main/resources/input/employees.csv"/>
            </input>
            <action type="transform">
                <method name="limit">
                     <param name="count" value="5"/>
                </method>
            </action>
            <output>
                <csv src="src/main/resources/output/clean_data.csv"/>
            </output>
        </task>
    </stage>
</job>
