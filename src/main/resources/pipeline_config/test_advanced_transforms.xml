<?xml version='1.0' encoding='UTF-8'?>
<job id="test_advanced">
    <datasources>
        <datasource id="ds_1" type="csv">
            <param name="src" value="src/main/resources/input/employees.csv" />
        </datasource>
        <datasource id="ds_2" type="csv">
            <param name="src" value="src/main/resources/output/test_1_drop.csv" />
        </datasource>
        <datasource id="ds_3" type="csv">
            <param name="src" value="src/main/resources/output/test_2_derive.csv" />
        </datasource>
        <datasource id="ds_4" type="csv">
            <param name="src" value="src/main/resources/output/test_3_join.csv" />
        </datasource>
        <datasource id="ds_5" type="csv">
            <param name="src" value="src/main/resources/output/test_4_sort.csv" />
        </datasource>
        <datasource id="ds_6" type="csv">
            <param name="src" value="src/main/resources/output/test_5_limit.csv" />
        </datasource>
    </datasources>
    <stage id="stage1">
        <task>
            <input ref="ds_1">
                </input>
            <action type="transform">
                <method name="drop_nulls">
                    <param name="columns" value="name" />
                </method>
            </action>
            <output ref="ds_2">
                </output>
        </task>
        <task>
            <input ref="ds_2">
                </input>
            <action type="transform">
                <method name="derive">
                    <param name="new_column" value="bonus" />
                    <param name="formula" value="salary * 0.1" />
                </method>
            </action>
            <output ref="ds_3">
                </output>
        </task>
    </stage>
    <stage id="stage2" pre_req="stage1">
        <task>
            <input ref="ds_3">
                </input>
            <action type="join">
                <method name="inner">
                    <param name="left_key" value="dept_id" />
                    <param name="right_key" value="dept_id" />
                    <param name="right_src" value="src/main/resources/input/departments.csv" />
                </method>
            </action>
            <output ref="ds_4">
                </output>
        </task>
    </stage>
    <stage id="stage3" pre_req="stage2">
        <task>
            <input ref="ds_4">
                </input>
            <action type="transform">
                <method name="sort">
                    <param name="column" value="bonus" />
                    <param name="order" value="desc" />
                </method>
            </action>
            <output ref="ds_5">
                </output>
        </task>
    </stage>
    <stage id="stage4" pre_req="stage3">
        <task>
            <input ref="ds_5">
                </input>
            <action type="transform">
                <method name="limit">
                    <param name="count" value="5" />
                </method>
            </action>
            <output ref="ds_6">
                </output>
        </task>
    </stage>
</job>